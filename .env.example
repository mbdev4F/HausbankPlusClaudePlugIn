# MCP server
PORT=8787
HAUSBANK_PLUS_MCP_TOKEN=replace-with-dev-token
NODE_ENV=development

# Deutsche Bank / Hausbank Plus API base (filled when Swagger arrives)
HAUSBANK_API_BASE_URL=https://api.example.deutsche-bank.com
HAUSBANK_API_ENV=sandbox

# Certificate provider: "file" (local) | "azure-keyvault" (production)
CERT_PROVIDER=file

# --- Local file provider (development only) ---
CLIENT_CERT_PATH=./certs/client.pem
CLIENT_KEY_PATH=./certs/client.key
# CLIENT_PFX_PATH=./certs/client.pfx
# CLIENT_KEY_PASSPHRASE=
# CA_BUNDLE_PATH=./certs/ca-bundle.pem

# --- Azure Key Vault provider (recommended for production) ---
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# AZURE_KEY_VAULT_CERT_NAME=hausbank-plus-client
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# Prefer Managed Identity in Azure over client secret.

# Request signing (framework TBD — stub until signing sample arrives)
SIGNING_MODE=stub
# SIGNING_KEY_ID=
