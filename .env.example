# MCP server (local + Vercel)
PORT=8787
CB_CONNECT_MCP_TOKEN=replace-with-dev-token
# HAUSBANK_PLUS_MCP_TOKEN=  # alias accepted by the server
NODE_ENV=development

# After Vercel deploy, set this in Claude / shell (not on the server):
# CB_CONNECT_MCP_URL=https://hausbank-plus-mcp.vercel.app/api/mcp

# Deutsche Bank CB-Connect credentials (from HealthFlow CBCON_* pattern)
CBCON_CLIENTID=
CBCON_KEYID=
CBCON_CLIENTSECRET=
CBCON_XCUSTOMERIDENTIFIER=
CBCON_CERTIFICATEBASE64=
CBCON_CERTIFICATEPASSWORD=
# Sandbox TLS if Node does not trust api.sbx.baas.db.com
CBCON_TLS_INSECURE=true

# Optional endpoint overrides (defaults = CB-Connect sandbox)
# CBCON_URL_OAUTH_TOKEN=
# CBCON_URL_ACCOUNT_BALANCE=
# CBCON_URL_ACCOUNT_BALANCE_HEALTH=
# CBCON_URL_VOP=
# CBCON_URL_INSTANT_PAYMENT_INIT=
# CBCON_URL_INSTANT_PAYMENT_STATUS=
# CBCON_URL_SWIFT_G4C=
# CBCON_URL_FX4CASH_INIT=
# CBCON_URL_FX4CASH_STATUS=
# CBCON_URL_FX4CASH_VALUE_DATE=
# CBCON_URL_STATEMENTS_REQUEST=
# CBCON_URL_STATEMENTS_LOAD=
# CBCON_STATEMENTS_VERSION=V2

# Optional Azure Key Vault signing (production)
# AZURE_KEY_VAULT_URL=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# CERT_PROVIDER=file

# finAPI Access + Web Form 2.0 (Open Banking / Multibank)
FINAPI_ENVIRONMENT=sandbox
FINAPI_CLIENT_ID=
FINAPI_CLIENT_SECRET=
# After finapi_provision_user (or from HealthFlow):
FINAPI_USER_ID=
FINAPI_USER_PASSWORD=
# Optional HTTPS origin for Web Form callbacks/redirects
# FINAPI_PUBLIC_ORIGIN=https://your-tunnel.example

# Better Payment (Wero + Pay by Bank / RTP)
BETTER_PAYMENT_ENVIRONMENT=sandbox
BETTER_PAYMENT_API_KEY=
BETTER_PAYMENT_OUTGOING_KEY=
# Optional: webhook checksum key (stored for reference)
# BETTER_PAYMENT_INCOMING_KEY=
# Optional API base override (defaults: testapi / api.betterpayment.de)
# BETTER_PAYMENT_API_BASE=
# HTTPS origin for success/error/postback (required unless URLs passed per call)
# BETTER_PAYMENT_PUBLIC_ORIGIN=https://hausbank-plus-mcp.vercel.app

# SME Deutsche Bank Connector (HealthFlow/Cash365 Biz-Banking / Business Connector)
# Distinct from CB-Connect (Enterprise). Hosts: simulator-api.db.com / api.db.com
SME_DB_ENVIRONMENT=sandbox
SME_DB_CLIENT_ID=
SME_DB_CLIENT_SECRET=
# After sme_db_oauth_start + browser login + callback:
SME_DB_REFRESH_TOKEN=
# HTTPS origin for OAuth callback (/api/sme-db-oauth/callback)
# SME_DB_PUBLIC_ORIGIN=https://hausbank-plus-mcp.vercel.app
# Aliases also accepted: CASH365_BIZBANK_CLIENT_ID / DEUTSCHE_BANK_BIZ_*

# Hausbank-Agent CloudConnector — Banqr OData APIs
# Prefer HAUSBANK_AGENT_*; HB365_* / BC_* aliases still work.
HAUSBANK_AGENT_TENANT_ID=
HAUSBANK_AGENT_ENVIRONMENT_NAME=
HAUSBANK_AGENT_CLIENT_ID=
HAUSBANK_AGENT_CLIENT_SECRET=
# Optional default company (otherwise pass companyId / call hausbank_agent_list_companies)
HAUSBANK_AGENT_COMPANY_ID=
# Optional overrides:
# HAUSBANK_AGENT_BASE_URL=https://api.businesscentral.dynamics.com
# HAUSBANK_AGENT_LOGIN_BASE_URL=https://login.microsoftonline.com
# HAUSBANK_AGENT_OAUTH_SCOPE=https://api.businesscentral.dynamics.com/.default
